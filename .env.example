# Postgres connection string for Payload. Use the Supabase SESSION POOLER (port 5432).
# Format: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Do NOT use the direct db.<ref>.supabase.co host; it is IPv6-only and fails on most laptops.
DATABASE_URI=

# Random unguessable string, 32+ chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Supabase Storage over the S3 protocol, used by the Payload media collection.
# Create the key pair in the dashboard: Storage -> S3 Configuration -> Access keys.
# These keys bypass RLS, server side only.
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region>
S3_BUCKET=portfolio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Seed profile. dev writes the placeholder contact details, public writes the
# owner's real ones and refuses to run without them.
SEED_PROFILE=dev

# The owner's contact details. Only the public seed reads these, and they
# stay out of the repository: fill them in .env.local, never in a tracked file.
OWNER_EMAIL=
OWNER_WHATSAPP=

# The admin account, used by the tools (scripts/set-admin-password.ts and
# scripts/verify-admin.mjs). Never the app itself.
ADMIN_EMAIL=
ADMIN_PASSWORD=
